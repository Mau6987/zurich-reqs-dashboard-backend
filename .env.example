# PostgreSQL — conexión directa a la base Zurich
POSTGRES_URL=postgresql://usuario:clave@host:5432/zurich

# Webhook de n8n para aprobar/rechazar/reagendar (§6 de la guía)
N8N_UI_WEBHOOK_URL=https://tu-n8n/webhook/zurich-ui

# Puerto del servidor
PORT=4000

# Secreto para verificar JWT (debe coincidir con el jwt-secret de PostgREST)
JWT_SECRET=tu-secreto-jwt

# Orígenes permitidos para CORS (separados por coma). Vacío = todos.
CORS_ORIGINS=http://localhost:3000
